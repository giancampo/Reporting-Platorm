# Copy to .env for local runs. In Cloud Run these are injected as env vars /
# Secret Manager references, never baked into the image.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# GCS bucket MUST be private (uniform bucket-level access, no public
# objects) and created in europe-west1 — same region as this Cloud Run job,
# so ETL reads/writes never generate egress charges. Location is immutable
# once the bucket exists.
GCS_BUCKET=reporting-platform-data

# Used for the Cloud Monitoring alert sink (alerting_sinks.py) and general
# ADC resolution; same GCP project that hosts the service account below.
GCP_PROJECT_ID=your-gcp-project-id

# Path to the GA4 service-account key (Secret Manager in production).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/ga4-service-account.json
