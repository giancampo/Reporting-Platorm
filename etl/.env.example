# Copy to .env for local runs. In Cloud Run these are injected as env vars /
# Secret Manager references, never baked into the image.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# R2 bucket MUST have been created with the `eu` jurisdiction; the endpoint
# below is the EU-jurisdiction-specific one, not the default R2 endpoint.
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.eu.r2.cloudflarestorage.com
R2_BUCKET=reporting-platform-data
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

# Path to the GA4 service-account key (Secret Manager in production).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/ga4-service-account.json

ALERT_WEBHOOK_URL=
