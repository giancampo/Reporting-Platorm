# Copy to .env for local runs (e.g. `uvicorn signing_service.asgi:app --reload`).
# In Cloud Run these are injected as env vars / Secret Manager references.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me

# Same bucket the ETL job writes to (etl/.env.example's GCS_BUCKET).
GCS_BUCKET=reporting-platform-data

# The identity this service runs as must hold roles/iam.serviceAccountTokenCreator
# on itself for signer.py's IAM signBlob-based signing to work — see README.
